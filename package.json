{
  "name": "dsh-livedocs",
  "version": "0.1.8",
  "description": "Version-pinned live library docs for DeepSeek Harness — kill hallucinated APIs.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale/*.json"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "docs",
    "context7",
    "llms-txt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sogoodayo/dsh-livedocs.git"
  },
  "bugs": "https://github.com/sogoodayo/dsh-livedocs/issues",
  "homepage": "https://github.com/sogoodayo/dsh-livedocs#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
